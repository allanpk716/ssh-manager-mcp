{{define "content"}}
{{if .Authorization}}{{template "authorization-subpage" .}}
<section class="authorization-detail-page">
<a class="back-link" href="/ui/authorization/secrets" aria-label="返回机密项"><span aria-hidden="true">‹</span>机密项</a>
{{if .SecretDetailNotice}}<div class="operation-refusal">{{.SecretDetailNotice}}</div>{{end}}
{{if .SecretDetailError}}<div class="operation-refusal">{{.SecretDetailError}}</div>{{end}}
<header class="detail-title"><h1>{{.Authorization.Detail.Name}}</h1><span class="status-tag">已授权 {{len .Authorization.Detail.Servers}} 台</span></header>
<section class="shared-card">
<div class="basic-identity"><p class="basic-name">{{.Authorization.Detail.Name}}</p><p class="basic-note">{{if .Authorization.Detail.Note}}{{.Authorization.Detail.Note}}{{else}}缺备注{{end}}</p></div>
<dl class="info-list">{{range .Authorization.Detail.Fields}}<div class="info-row"><dt>{{.Label}}</dt><dd>{{if .Value}}{{.Value}}{{else}}（未设置）{{end}}</dd></div>{{end}}</dl>
{{if .Caps.CanManageSecrets}}
<form method="post" action="/ui/secrets/{{.Authorization.Detail.ID}}/edit" class="metadata-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<div class="form-field"><label for="note">备注</label><input type="text" id="note" name="note" value="{{if or .SecretDetailError .SecretDetailMetadataResume}}{{.SecretDetailNote}}{{else}}{{.SecretDetail.Row.Note}}{{end}}" required></div>
<div class="form-field"><label for="environment_name">环境变量名（留空表示清除）</label><input type="text" id="environment_name" name="environment_name" value="{{if or .SecretDetailError .SecretDetailMetadataResume}}{{.SecretDetailEnvironmentName}}{{else}}{{.SecretDetail.Row.EnvironmentName}}{{end}}"></div>
<button type="submit">保存基本信息</button>
</form>
{{end}}
</section>
<section class="shared-card wide-card">
<div class="section-heading"><h2>授权的服务器</h2>{{if .Authorization.Detail.CanAdjust}}<a class="secondary-link" href="{{.Authorization.Detail.SelectionPath}}">调整服务器</a>{{end}}</div>
{{if .Authorization.Detail.Servers}}<div class="server-chip-list">{{range .Authorization.Detail.Servers}}<span>{{.Name}}</span>{{end}}</div>{{else}}<p class="empty-inline">尚未授权任何服务器。</p>{{end}}
</section>
{{if .Caps.CanWrite}}
<section class="shared-card" aria-label="实际能拿到它的客户端">
<h2>实际能拿到它的客户端</h2>
<p class="section-note">客户端的 profile 中包含任一可写入服务器，就能拿到这个机密项。</p>
{{if .Authorization.Detail.Clients}}<div class="row-list">{{range .Authorization.Detail.Clients}}<div class="client-row"><span class="row-icon">客</span><span class="row-copy"><a href="/ui/clients/{{.ClientID}}"><strong>{{.ClientName}}</strong></a><small>profile {{.Profile}} · {{.ViaText}}</small></span></div>{{end}}</div>{{else}}<p class="empty-inline">当前没有客户端能拿到它。</p>{{end}}
</section>
{{end}}
<section class="shared-card">
<h2>下发记录</h2>
<p class="section-note">登记失败的历史写入会缺漏，不承诺完整；记录与模板原文不包含机密项值。</p>
{{if .SecretDetail.DeliveryRecords}}
<div class="row-list">
{{range .SecretDetail.DeliveryRecords}}
<div class="record-row"><span class="row-icon">录</span><span class="row-copy"><strong>{{.ServerName}} <code>{{.Path}}</code></strong><small>{{formatTime .WrittenAt}} · {{.InitiatingDeviceName}} / {{.InitiatingInstanceName}}</small>{{if .Template}}<small>模板原文 <code>{{.Template}}</code></small>{{end}}{{if .FileSHA256}}<small>文件 SHA-256 哈希 <code>{{.FileSHA256}}</code></small>{{end}}{{range .Secrets}}<small>{{.Name}}{{if .Deleted}}（已删除）{{end}} · 值版本 {{.ValueVersion}}</small>{{end}}</span></div>
{{end}}
</div>
{{else}}<p class="empty-inline">该机密项没有下发记录。</p>{{end}}
</section>
{{if .Caps.CanManageSecrets}}<div class="inline-form"><a class="button-link" href="/ui/secrets/{{.Authorization.Detail.ID}}/value">换值</a><a class="button-link danger" href="/ui/secrets/{{.Authorization.Detail.ID}}/delete">删除</a></div>{{end}}
</section>{{end}}
{{end}}
