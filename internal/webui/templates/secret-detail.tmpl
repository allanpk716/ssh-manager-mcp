{{define "content"}}
<section class="secret-detail">
<h1>{{.SecretDetail.Row.Name}}</h1>
{{if .SecretDetailNotice}}<div class="operation-refusal">{{.SecretDetailNotice}}</div>{{end}}
{{if .SecretDetailError}}<div class="operation-refusal">{{.SecretDetailError}}</div>{{end}}
<dl class="detail-list">
<dt>标识符</dt><dd>{{.SecretDetail.Row.ID}}</dd>
<dt>备注</dt><dd>{{or .SecretDetail.Row.Note "-"}}</dd>
<dt>环境变量名</dt><dd>{{or .SecretDetail.Row.EnvironmentName "（未设置）"}}</dd>
<dt>可写入服务器</dt><dd>{{if .SecretDetail.Row.AllowedServers}}{{joinTags .SecretDetail.Row.AllowedServers}}{{else}}（无）{{end}}</dd>
<dt>创建时间</dt><dd>{{formatUnixTime .SecretDetail.Row.CreatedAt}}</dd>
<dt>值最后更改</dt><dd>{{formatUnixTime .SecretDetail.Row.ValueUpdatedAt}}</dd>
</dl>
<form method="post" action="/ui/secrets/{{.SecretDetail.Row.ID}}/edit" class="secret-metadata-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<div class="form-field"><label for="note">备注</label><input type="text" id="note" name="note" value="{{if .SecretDetailError}}{{.SecretDetailNote}}{{else}}{{.SecretDetail.Row.Note}}{{end}}"></div>
<div class="form-field"><label for="environment_name">环境变量名（留空表示清除）</label><input type="text" id="environment_name" name="environment_name" value="{{if .SecretDetailError}}{{.SecretDetailEnvironmentName}}{{else}}{{.SecretDetail.Row.EnvironmentName}}{{end}}"></div>
<button type="submit">修改元数据</button>
</form>
<form method="post" action="/ui/secrets/authorization/preview" class="grant-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="return_to" value="/ui/secrets/{{.SecretDetail.Row.ID}}">
<input type="hidden" name="secret_id" value="{{.SecretDetail.Row.ID}}">
{{range .SecretDetail.Servers}}<input type="hidden" name="server_id" value="{{.ID}}">{{end}}
<fieldset><legend>可写入服务器勾选清单</legend>
{{range .SecretDetail.Servers}}
<label class="grant-choice"><input type="checkbox" name="{{secretCellName $.SecretDetail.Row.ID .ID}}" value="1"{{if .Checked}} checked{{end}}><span>{{.Name}}</span></label>
{{end}}
<button type="submit">预览可写入服务器变更</button>
</fieldset>
</form>
<div class="inline-form secret-actions">
<a class="button-link" href="/ui/secrets/{{.SecretDetail.Row.ID}}/value">换值</a>
<a class="button-link danger" href="/ui/secrets/{{.SecretDetail.Row.ID}}/delete">删除</a>
<a class="button-link" href="/ui/secrets/">返回机密项列表</a>
</div>
</section>
{{end}}
