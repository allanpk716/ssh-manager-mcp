{{define "content"}}
<section class="software-inventory">
<h1>软件清单待办</h1>
{{if .SoftwareInventoryNotice}}<p class="form-success">{{.SoftwareInventoryNotice}}</p>{{end}}

<h2>待确认暴露</h2>
<ul class="record-cards">
{{range .SoftwareInventoryTodos.PendingExposure}}
{{$device := .}}
<li class="record-card">
<h2>{{.DeviceName}}</h2>
<dl class="field-list">
<dt>监听端口与实测暴露级别</dt>
<dd>{{range .Ports}}<div>{{if .Address}}{{.Address}}:{{else}}*:{{end}}{{.Port}}/{{.Protocol}} · {{.ExposureLabel}}</div>{{end}}</dd>
<dt>处理</dt><dd>{{range .Ports}}<a href="{{declarationFormPath $device.DeviceName .ObservedStableKey .Address .Port .Protocol "all_addresses"}}">进入声明表单</a> {{end}}</dd>
</dl>
</li>
{{else}}<li class="empty-text">没有。</li>{{end}}
</ul>

<h2>未识别进程</h2>
<ul class="record-cards">
{{range .SoftwareInventoryTodos.UnidentifiedProcesses}}
{{$process := .}}
<li class="record-card">
<h2>{{.DeviceName}} · {{if .ProcessName}}{{.ProcessName}}{{else}}{{.Name}}{{end}}</h2>
<dl class="field-list">
<dt>可执行文件</dt><dd>{{.ExecutablePath}}</dd>
<dt>监听端口</dt><dd>{{range .ListeningPorts}}<div>{{if .Address}}{{.Address}}:{{else}}*:{{end}}{{.Port}}/{{.Protocol}} · {{.ExposureLabel}}</div>{{end}}</dd>
<dt>处理</dt><dd>{{range .ListeningPorts}}<a href="{{declarationFormPath $process.DeviceName $process.ObservedStableKey .Address .Port .Protocol "all_addresses"}}">认领</a> {{end}}</dd>
</dl>
</li>
{{else}}<li class="empty-text">没有。</li>{{end}}
</ul>

<h2>对不上与清单过期</h2>
<ul class="record-cards">
{{range .SoftwareInventoryTodos.Mismatches}}
<li class="record-card">
<h2>{{.DeviceName}} · {{.Name}}</h2>
<dl class="field-list">
<dt>类型</dt><dd>对不上</dd>
<dt>内容</dt><dd>{{.Reason}}</dd>
<dt>处理</dt><dd><a href="/ui/software-inventory/declarations/edit?id={{.DeclarationID | urlquery}}">修改声明</a></dd>
</dl>
</li>
{{end}}
{{range .SoftwareInventoryTodos.StaleDevices}}
<li class="record-card">
<h2>{{.DeviceName}}</h2>
<dl class="field-list">
<dt>类型</dt><dd>清单过期</dd>
<dt>内容</dt><dd>{{if .NeverCollected}}从未成功采集{{else}}上次成功采集 {{formatOptionalTime .LastSuccessAt}}{{end}}</dd>
<dt>处理</dt><dd><a href="/ui/software-inventory/devices?device={{.DeviceName | urlquery}}">查看设备清单</a></dd>
</dl>
</li>
{{else}}{{if not .SoftwareInventoryTodos.Mismatches}}<li class="empty-text">没有。</li>{{end}}{{end}}
</ul>
</section>
{{end}}
