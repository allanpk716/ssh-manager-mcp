{{define "content"}}
<section class="software-inventory">
<h1>软件清单</h1>
<div class="inline-form">
<a class="button-link" href="/ui/software-inventory/search">跨设备搜索</a>
<a class="button-link" href="/ui/software-inventory/todos">待办</a>
<a class="button-link" href="/ui/software-inventory/drafts">草稿审阅</a>
<a class="button-link" href="/ui/software-inventory/declarations">生效声明</a>
<a class="button-link" href="/ui/software-inventory/settings">采集设置</a>
<a class="button-link" href="/ui/software-inventory/declarations/new">新增声明</a>
</div>
{{if .SoftwareInventoryError}}<p class="form-error">{{.SoftwareInventoryError}}</p>{{end}}
{{if .SoftwareInventoryNotice}}<p class="form-success">{{.SoftwareInventoryNotice}}</p>{{end}}
<ul class="record-cards">
{{range .SoftwareInventoryDevices}}
<li class="record-card">
<h2><a href="/ui/software-inventory/devices?device={{.Name | urlquery}}">{{.Name}}</a></h2>
<dl class="field-list">
<dt>采集状态</dt><dd>{{template "softwareInventoryStatus" .Status}}</dd>
</dl>
</li>
{{else}}<li class="empty-text">暂无设备。</li>{{end}}
</ul>
</section>
{{end}}

{{define "softwareInventoryStatus"}}
{{if .Managed}}{{.CollectorLabel}}{{else}}不受管设备，没有采集执行者{{end}}；上次成功 {{formatOptionalTime .LastSuccessAt}}；上次失败 {{formatOptionalTime .LastFailureAt}}{{if .LastFailureReason}}（{{.LastFailureReason}}）{{end}}；{{if .Stale}}清单已过期{{else}}清单未过期{{end}}
{{end}}
