{{define "content"}}
<section class="secrets-page">
<h1>机密项</h1>
{{if not .Caps.CanWrite}}<p class="readonly-notice">只显示本客户端可用的部分，修改请到权威端。</p>{{end}}
<form class="filter-form" method="get" action="/ui/secrets/">
<label for="secret-query">搜索名字或备注</label>
<input type="search" id="secret-query" name="query" value="{{.SecretFilterQuery}}">
<label for="secret-server">按服务器筛选</label>
<select id="secret-server" name="server">
<option value="">全部服务器</option>
{{range .SecretServerOptions}}<option value="{{.Name}}"{{if eq $.SecretFilterServer .Name}} selected{{end}}>{{.Name}}</option>{{end}}
</select>
<button type="submit">筛选</button>
</form>
<div class="inline-form">
{{if .Caps.CanManageSecrets}}<a class="button-link" href="/ui/secrets/new">新增机密项</a>
<a class="button-link" href="/ui/secrets/matrix">授权矩阵</a>{{end}}
</div>
<table class="server-table secrets-table">
<thead><tr><th>名字</th><th>备注</th><th>环境变量名</th><th>可写入服务器</th>{{if .Caps.CanWrite}}<th>创建时间</th><th>值最后更改</th>{{end}}<th>操作</th></tr></thead>
<tbody>
{{range .Secrets}}
<tr>
<td><a href="/ui/secrets/{{.ID}}">{{.Name}}</a></td>
<td>{{or .Note "-"}}</td>
<td>{{or .EnvironmentName "（未设置）"}}</td>
<td>{{if .AllowedServers}}{{joinTags .AllowedServers}}{{else}}（无）{{end}}</td>
{{if $.Caps.CanWrite}}<td>{{formatUnixTime .CreatedAt}}</td><td>{{formatUnixTime .ValueUpdatedAt}}</td>{{end}}
<td><a href="/ui/secrets/{{.ID}}">详情</a></td>
</tr>
{{end}}
</tbody>
</table>
</section>
{{end}}
