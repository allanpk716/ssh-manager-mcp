{{define "content"}}
{{if .Authorization}}{{template "authorization-subpage" .}}
<section class="authorization-list-page">
<header class="title-row"><h1>机密项</h1>{{if .Caps.CanManageSecrets}}<a class="primary-action" href="/ui/authorization/secrets/new">新建机密项</a>{{end}}</header>
{{if not .Caps.CanWrite}}<p class="readonly-notice">只显示本客户端可用的部分，修改请到权威端。</p>{{end}}
<form class="filter-form authorization-filter" method="get" action="/ui/authorization/secrets">
<div class="form-field"><label for="secret-query">搜索名字或备注</label>
<input type="search" id="secret-query" name="query" value="{{.Authorization.Query}}"></div>
<div class="form-field"><label for="secret-server">按服务器筛选</label>
<select id="secret-server" name="server">
<option value="">全部服务器</option>
{{range .Authorization.ServerOptions}}<option value="{{.Name}}"{{if eq $.Authorization.ServerFilter .Name}} selected{{end}}>{{.Name}}</option>{{end}}
</select></div>
<button type="submit">筛选</button>
</form>
<div class="list-meta"><span>{{len .Authorization.Secrets}} 个机密项</span><span>点卡片查看授权与下发记录</span></div>
<div class="authorization-resource-list">
{{range .Authorization.Secrets}}
<a class="resource-card resource-only" href="/ui/authorization/secrets/{{.Secret.ID}}">
<span class="resource-icon">密</span>
<span class="resource-copy"><strong>{{.Secret.Name}}</strong><small class="resource-note">{{if .Secret.Note}}{{.Secret.Note}}{{else}}缺备注{{end}}</small><small>{{if .Secret.EnvironmentName}}环境变量 {{.Secret.EnvironmentName}} · {{end}}授权 {{len .Secret.AllowedServers}} 台 · {{.ClientCount}} 个客户端能拿到</small></span>
<span class="chevron-icon">›</span>
</a>
{{else}}<div class="home-empty-card">没有机密项。</div>{{end}}
</div>
{{if .Caps.CanManageSecrets}}<a class="secondary-link" href="/ui/secrets/matrix">查看授权矩阵</a>{{end}}
</section>{{end}}
{{end}}
