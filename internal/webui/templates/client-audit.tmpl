{{define "content"}}
<section class="client-audit-page">
<h1>本机审计</h1>
<p class="client-audit-instance">实例：{{.OpsClientInstance}}</p>
{{if .OpsClientAuditRows}}
<table class="server-table audit-table">
<thead>
<tr><th scope="col">时间</th><th scope="col">项目</th><th scope="col">服务器</th><th scope="col">动作</th><th scope="col">摘要</th><th scope="col">状态</th><th scope="col">来源</th><th scope="col">来源地址</th></tr>
</thead>
<tbody>
{{range .OpsClientAuditRows}}
<tr class="audit-row">
<td>{{.TS.Format "2006-01-02 15:04:05"}}</td>
<td>{{.ProjectDisplay}}</td>
<td>{{.ServerDisplay}}</td>
<td>{{.Action}}</td>
<td>{{.CommandDisplay}}</td>
<td>{{.Status}}</td>
<td>{{.SourceText}}</td>
<td>{{if .SourceIP}}{{.SourceIP}}{{else}}—{{end}}</td>
</tr>{{end}}
</tbody>
</table>
{{else}}
<p class="empty-list">没有本机审计记录。</p>
{{end}}
</section>
{{end}}
