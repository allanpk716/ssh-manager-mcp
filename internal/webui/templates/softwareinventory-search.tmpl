{{define "content"}}
<section class="software-inventory">
<h1>软件清单搜索</h1>
<form method="get" action="/ui/software-inventory/search">
<label for="software-inventory-query">软件名</label>
<input id="software-inventory-query" type="search" name="query" value="{{.SoftwareInventoryQuery}}">
<button type="submit">搜索</button>
</form>

{{if .SoftwareInventoryQuery}}
<ul class="record-cards">
{{range .SoftwareInventorySearchRows}}
<li class="record-card">
<h2><a href="/ui/software-inventory/devices?device={{.DeviceName | urlquery}}">{{.DeviceName}}</a></h2>
<dl class="field-list">
<dt>软件名</dt><dd>{{.Item.Name}}</dd>
<dt>精确版本</dt><dd>{{.Item.Version}}</dd>
<dt>来源</dt><dd>{{.Item.Source}}</dd>
<dt>监听端口与暴露级别</dt><dd>{{if .Item.ListeningPorts}}{{range .Item.ListeningPorts}}<div>{{if .Address}}{{.Address}}:{{else}}*:{{end}}{{.Port}}/{{.Protocol}} · {{.ExposureLabel}}</div>{{end}}{{else}}未登记监听端口{{end}}</dd>
</dl>
</li>
{{else}}<li class="empty-text">没有匹配的软件条目。</li>{{end}}
</ul>
{{else}}
<p>输入软件名（例如 openssh）后，会列出每台设备上的版本、来源与暴露级别。</p>
{{end}}
</section>
{{end}}
