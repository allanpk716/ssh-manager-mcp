{{define "content"}}
<section class="secret-preview">
<h1>机密项授权预览</h1>
{{if .SecretAuthorizationNotice}}<div class="operation-refusal">{{.SecretAuthorizationNotice}}</div>{{end}}
{{if not .SecretAuthorizationPreview.Changes}}
<p>没有变化。</p>
{{else}}
<p>新增 {{.SecretAuthorizationPreview.TotalAdded}} 个授权，移除 {{.SecretAuthorizationPreview.TotalRemoved}} 个授权。</p>
<table class="server-table">
<thead><tr><th>机密项</th><th>新增可写入服务器</th><th>移除可写入服务器</th></tr></thead>
<tbody>
{{range .SecretAuthorizationPreview.Changes}}
<tr><td>{{.SecretName}}</td><td>{{if .Added}}{{range .Added}}{{.Name}} {{end}}{{else}}无{{end}}</td><td>{{if .Removed}}{{range .Removed}}{{.Name}} {{end}}{{else}}无{{end}}</td></tr>
{{end}}
</tbody>
</table>
{{end}}
{{if .SecretAuthorizationShareRevokes}}
<div class="notice notice-warning">
<p>最近现场探测显示以下将移除的服务器仍挂载。需要同时清理远端配置时，请逐台执行撤销授权并选择同时卸载。</p>
<ul>
{{range .SecretAuthorizationShareRevokes}}<li>{{.ShareName}} · {{.ServerName}}：<a class="button-link" href="{{.ConfirmPath}}">同时卸载并撤销授权</a></li>{{end}}
</ul>
</div>
{{end}}
<form method="post" action="/ui/secrets/authorization/confirm" class="confirm-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="summary" value="{{.SecretAuthorizationPreview.Summary}}">
<input type="hidden" name="return_to" value="{{.SecretAuthorizationReturnTo}}">
{{range .SecretAuthorizationTargets}}<input type="hidden" name="target" value="{{secretTargetValue .}}">{{end}}
{{if .SecretAuthorizationPreview.Changes}}<button type="submit">确认保存授权</button>{{end}}
<a class="button-link" href="{{.SecretAuthorizationReturnTo}}">返回继续调整</a>
</form>
</section>
{{end}}
