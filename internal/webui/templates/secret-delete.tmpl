{{define "content"}}
<section class="secret-delete">
<h1>删除 {{.SecretDetail.Row.Name}}</h1>
<div class="operation-refusal"><p>删除前请核对以下信息；确认一次后立即执行。</p></div>
<dl class="detail-list">
<dt>名字</dt><dd>{{.SecretDetail.Row.Name}}</dd>
<dt>环境变量名</dt><dd>{{or .SecretDetail.Row.EnvironmentName "（未设置）"}}</dd>
<dt>可写入服务器</dt><dd>{{if .SecretDetail.Row.AllowedServers}}{{joinTags .SecretDetail.Row.AllowedServers}}{{else}}（无）{{end}}</dd>
</dl>
<form method="post" action="/ui/secrets/{{.SecretDetail.Row.ID}}/delete" class="confirm-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<button type="submit">确认删除</button>
<a class="button-link" href="/ui/secrets/{{.SecretDetail.Row.ID}}">取消</a>
</form>
</section>
{{end}}
