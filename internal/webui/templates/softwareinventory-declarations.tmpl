{{define "content"}}
<section class="software-inventory">
<h1>生效软件声明</h1>
{{if .SoftwareInventoryNotice}}<p class="form-success">{{.SoftwareInventoryNotice}}</p>{{end}}
<ul class="record-cards">
{{range .SoftwareInventoryDeclarations}}
<li class="record-card">
<h2>{{.Device}} · {{.Name}}</h2>
<dl class="field-list">
<dt>类别</dt><dd>{{.CategoryLabel}}</dd>
<dt>精确版本</dt><dd>{{.Version}}</dd>
<dt>监听端口</dt><dd>{{range .ListeningPorts}}{{.Address}}:{{.Port}}/{{.Protocol}} {{else}}未登记监听端口{{end}}</dd>
</dl>
<div class="card-actions">
<a class="button-link" href="/ui/software-inventory/declarations/edit?id={{.ID | urlquery}}">修改</a>
<a class="button-link danger-link" href="/ui/software-inventory/declarations/delete?id={{.ID | urlquery}}">删除</a>
</div>
</li>
{{else}}<li class="empty-text">暂无生效软件声明。</li>{{end}}
</ul>
<p><a class="button-link" href="/ui/software-inventory/declarations/new">新增声明</a></p>
</section>
{{end}}
