{{define "content"}}
<section class="server-delete">
<h1>删除 {{.ServerDeletePreview.ServerName}}</h1>
{{if .ServerDeleteNotice}}<div class="operation-refusal"><p>{{.ServerDeleteNotice}}</p></div>{{end}}
<div class="operation-refusal">
<p>删除前请核对影响预览；确认一次后立即执行。</p>
</div>
<dl class="detail-list">
<dt>服务器条目</dt><dd>{{.ServerDeletePreview.ServerName}}（{{.ServerDeletePreview.ServerID}}）</dd>
<dt>所属设备</dt><dd>{{if .ServerDeletePreview.HasDevice}}设备保留：{{.ServerDeletePreview.DeviceName}}{{else}}无{{end}}</dd>
<dt>主机密钥锚</dt><dd>要删除 {{.ServerDeletePreview.AnchorCount}} 个</dd>
<dt>失去这台服务器的 profile</dt><dd>{{if .ServerDeletePreview.ProfileNames}}{{joinTags .ServerDeletePreview.ProfileNames}}{{else}}无{{end}}</dd>
<dt>移出可写入服务器列表的机密项</dt><dd>{{if .ServerDeletePreview.SecretNames}}{{joinTags .ServerDeletePreview.SecretNames}}{{else}}无{{end}}</dd>
<dt>会随之删除的凭据</dt><dd>{{if .ServerDeletePreview.DeletedCredentials}}{{joinTags .ServerDeletePreview.DeletedCredentials}}{{else}}无{{end}}</dd>
<dt>因共用而保留的凭据</dt><dd>{{if .ServerDeletePreview.KeptCredentials}}{{joinTags .ServerDeletePreview.KeptCredentials}}{{else}}无{{end}}</dd>
</dl>
<form method="post" action="/ui/servers/{{.ServerDeletePreview.ServerID}}/delete" class="confirm-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="server_id" value="{{.ServerDeletePreview.ServerID}}">
<input type="hidden" name="digest" value="{{.ServerDeletePreview.Digest}}">
<button type="submit">确认删除</button>
<a class="button-link" href="/ui/servers/{{.ServerDeletePreview.ServerID}}">取消</a>
</form>
</section>
{{end}}
