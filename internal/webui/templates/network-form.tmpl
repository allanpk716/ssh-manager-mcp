{{define "content"}}
<section class="network-form-page">
<div class="subpage-header">
<a class="button-link" href="/ui/more/locations-networks/?tab=networks">返回地点与网络</a>
<h1>{{if eq .NetworkForm.Mode "create"}}新建网络{{else}}编辑网络{{end}}</h1>
</div>
{{if .NetworkForm.Error}}<div class="operation-refusal"><p>{{.NetworkForm.Error}}</p></div>{{end}}
<form method="post" action="{{if eq .NetworkForm.Mode "create"}}/ui/more/networks/new{{else}}/ui/more/networks/edit{{end}}">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
{{if eq .NetworkForm.Mode "edit"}}<input type="hidden" name="original" value="{{.NetworkForm.Name}}">{{end}}
{{if eq .NetworkForm.Mode "create"}}
<fieldset class="form-fields">
<legend>网络类型</legend>
<label class="grant-choice"><input type="radio" name="type" value="physical"{{if eq .NetworkForm.Type "physical"}} checked{{end}}>物理局域网</label>
<label class="grant-choice"><input type="radio" name="type" value="virtual"{{if eq .NetworkForm.Type "virtual"}} checked{{end}}>虚拟局域网</label>
</fieldset>
{{else}}
<dl class="field-list">
<dt>网络类型</dt><dd>{{if eq .NetworkForm.Type "physical"}}物理局域网{{else}}虚拟局域网{{end}}（登记后不可修改）</dd>
</dl>
{{end}}
<div class="form-field">
<label for="network-name">名称</label>
<input id="network-name" name="name" value="{{.NetworkForm.Name}}" maxlength="40" autocomplete="off" required>
</div>
<div class="form-field">
<label for="network-range">网段</label>
<input id="network-range" name="range" value="{{.NetworkForm.NetworkRange}}" maxlength="50" autocomplete="off" placeholder="例如：192.168.100.0/24">
</div>
{{if eq .NetworkForm.Type "physical"}}
<fieldset class="form-fields">
<legend>覆盖地点</legend>
{{range .NetworkForm.Options}}
<label class="tree-option {{.DepthClass}}">
<input type="radio" name="site" value="{{.Site.LocationPath}}"{{if eq $.NetworkForm.Site .Site.LocationPath}} checked{{end}}>
<span>{{.Site.Name}}{{if .Depth}} <span class="muted">（{{.Site.LocationPath}}）</span>{{end}}</span>
</label>
{{end}}
</fieldset>
{{end}}
<div class="form-field">
<label for="network-bandwidth">标称带宽（Mbps）</label>
<input id="network-bandwidth" name="bandwidth_mbps" value="{{.NetworkForm.BandwidthMbps}}" inputmode="numeric" autocomplete="off" placeholder="例如：1000">
</div>
<div class="form-field checkbox-field">
<label><input type="checkbox" name="metered" value="1"{{if .NetworkForm.Metered}} checked{{end}}>按流量计费</label>
<p class="form-help">用于连接时权衡地址选择。</p>
</div>
<button type="submit">保存</button>
</form>
</section>
{{end}}
