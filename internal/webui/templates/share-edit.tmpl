{{define "content"}}
<section class="share-form">
<h1>编辑 {{.ShareEdit.Detail.Name}}</h1>
{{if .ShareEdit.Error}}<div class="operation-refusal">{{.ShareEdit.Error}}</div>{{end}}
<p class="form-help">只提交有变化的字段；保存成功后共享存储版本号加一，agent 会收到变更提示。</p>
<form method="post" action="/ui/shares/{{.ShareEdit.Detail.ID}}/edit">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<div class="form-field"><label for="share-name">共享名</label><input type="text" id="share-name" name="name" value="{{.ShareEdit.Form.Name}}" required></div>
<div class="form-field"><label for="share-device">提供方设备</label><input type="text" id="share-device" name="device" value="{{.ShareEdit.Form.Device}}" required></div>
<div class="form-field"><label for="share-user">专用挂载账号用户名</label><input type="text" id="share-user" name="user" value="{{.ShareEdit.Form.User}}" required></div>
<div class="form-field"><label for="share-password-secret">挂载密码机密项</label><input type="text" id="share-password-secret" name="password_secret" value="{{.ShareEdit.Form.PasswordSecret}}" required></div>
<div class="form-field"><label for="share-drive">固定盘符（D 到 Z）</label><input type="text" id="share-drive" name="drive" value="{{.ShareEdit.Form.Drive}}" required></div>
<div class="form-field"><label for="share-directories">目录约定（每行一条，格式为 用途=子路径；留空表示清空）</label><textarea id="share-directories" name="directories" rows="4">{{.ShareEdit.Form.Directories}}</textarea></div>
<div class="form-field"><label for="share-note">备注</label><input type="text" id="share-note" name="note" value="{{.ShareEdit.Form.Note}}"></div>
<div class="form-field"><label for="share-change-note">变更说明</label><input type="text" id="share-change-note" name="change_note" value="{{.ShareEdit.ChangeNote}}"></div>
<p class="form-help">挂载密码只保存在机密项里；本页面不读取、不显示、也不提供复制机密项值的入口。</p>
<button type="submit">保存</button>
<a class="button-link" href="/ui/shares/{{.ShareEdit.Detail.ID}}">取消</a>
</form>
</section>
{{end}}
