{{define "content"}}
<section class="secret-form">
<h1>换值 {{.SecretDetail.Row.Name}}</h1>
{{if .SecretDetailError}}<div class="operation-refusal">{{.SecretDetailError}}</div>{{end}}
<p class="form-help">页面不显示旧值；换值后上一个值仍会参与输出遮蔽。</p>
<form method="post" action="/ui/secrets/{{.SecretDetail.Row.ID}}/value" enctype="multipart/form-data">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<div class="form-field"><label for="value">新值</label><input type="password" id="value" name="value" autocomplete="off"></div>
<div class="form-field"><label for="value_file">或上传文件作为新值</label><input type="file" id="value_file" name="value_file"></div>
<button type="submit">确认换值</button>
<a class="button-link" href="/ui/secrets/{{.SecretDetail.Row.ID}}">取消</a>
</form>
</section>
{{end}}
