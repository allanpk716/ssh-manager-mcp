{{define "content"}}
<section class="share-unmount-page"{{if and .ShareUnmount.Task (eq .ShareUnmount.Task.State "running")}} id="share-unmount-task" hx-get="{{.ShareUnmount.PollPath}}" hx-trigger="every 1s" hx-swap="outerHTML"{{end}}>
<h1>{{if .ShareUnmount.Task}}{{if eq .ShareUnmount.Task.State "running"}}卸载进行中{{else}}卸载结果{{end}}{{else}}卸载 {{.ShareUnmount.Share.Name}} · {{.ShareUnmount.Server.Name}}{{end}}</h1>
<dl class="detail-list">
<dt>共享存储</dt><dd>{{.ShareUnmount.Share.Name}}</dd>
<dt>服务器条目</dt><dd>{{.ShareUnmount.Server.Name}}</dd>
<dt>挂载点</dt><dd>{{.ShareUnmount.Server.MountPoint}}</dd>
</dl>
{{if .ShareUnmount.Task}}
{{if eq .ShareUnmount.Task.State "running"}}
<div class="notice notice-info"><p>正在删除远端持久挂载配置并卸载挂载点，请稍候；页面会自动刷新。</p></div>
{{else}}
<div class="operation-result">
<p><strong>{{shareUnmountResultLabel .ShareUnmount.Task.Result}}</strong>{{if .ShareUnmount.Task.Force}}（强制执行）{{end}}{{if .ShareUnmount.Task.FailureMessage}}：{{.ShareUnmount.Task.FailureMessage}}{{end}}</p>
{{if eq .ShareUnmount.Task.Result "success"}}<div class="notice notice-success"><p>远端持久挂载配置已删除，挂载点已卸载；共享存储版本号：{{.ShareUnmount.Task.Version}}。</p></div>{{end}}
{{if .ShareUnmount.Task.Notices}}<div class="notice notice-warning"><ul>{{range .ShareUnmount.Task.Notices}}<li>{{.}}</li>{{end}}</ul></div>{{end}}
{{if .ShareUnmount.Task.BusyProcesses}}
<div class="share-unmount-busy">
<p>占用挂载点的进程：</p>
<table class="server-table">
<thead><tr><th>进程号</th><th>用户</th><th>命令名</th></tr></thead>
<tbody>
{{range .ShareUnmount.Task.BusyProcesses}}<tr><td>{{.ProcessID}}</td><td>{{.User}}</td><td>{{.Command}}</td></tr>{{end}}
</tbody>
</table>
<form method="post" action="/ui/shares/{{.ShareUnmount.Share.ID}}/unmount" class="confirm-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="server_id" value="{{.ShareUnmount.Server.ID}}">
<input type="hidden" name="force" value="1">
<button type="submit">强制卸载</button>
</form>
<a class="button-link" href="{{.ShareUnmount.ConfirmPath}}">稍后再试</a>
</div>
{{end}}
{{if eq .ShareUnmount.Task.Result "ssh-error"}}<div class="notice notice-warning"><p>任务已当场失败，未排队重试；稍后可用「检查残留」兜底检查这台服务器。</p></div>{{end}}
</div>
{{end}}
{{else}}
{{if .ShareUnmount.TaskInvalid}}<div class="notice notice-warning"><p>卸载任务结果已失效（进程重启或任务被清理）；如需继续，请重新确认并发起。</p></div>{{end}}
{{if .ShareUnmount.Windows}}
<div class="operation-refusal"><p>Windows 服务器不能执行共享存储卸载：sshmgr 不在其上留下任何持久改动。</p></div>
{{else}}
<div class="operation-refusal"><p>将删除服务器上的远端持久挂载配置，再卸载挂载点。被占用时会列出占用进程，由你决定强制卸载或稍后再试。</p></div>
<form method="post" action="/ui/shares/{{.ShareUnmount.Share.ID}}/unmount" class="confirm-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="server_id" value="{{.ShareUnmount.Server.ID}}">
<button type="submit">确认卸载</button>
<a class="button-link" href="/ui/shares/{{.ShareUnmount.Share.ID}}">取消</a>
</form>
{{end}}
{{end}}
<div class="inline-form">
<a class="button-link" href="/ui/shares/{{.ShareUnmount.Share.ID}}">返回共享存储详情</a>
</div>
</section>
{{end}}
