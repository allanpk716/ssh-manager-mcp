{{define "layout"}}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="htmx-config" content='{"includeIndicatorStyles":false}'>
<meta name="csrf-token" content="{{.CSRFToken}}">
<title>{{.Title}} · sshmgr</title>
<link rel="stylesheet" href="{{index .Assets "app.css"}}">
<script src="{{index .Assets "htmx.min.js"}}" defer></script>
<script src="{{index .Assets "app.js"}}" defer></script>
<script src="{{index .Assets "secrets-matrix.js"}}" defer></script>
{{if .TopologyPage}}<link rel="stylesheet" href="{{index .Assets "topology.css"}}">
<script src="{{index .Assets "cytoscape.min.js"}}" defer></script>
<script src="{{index .Assets "topology.js"}}" defer></script>{{end}}
</head>
<body>
<svg class="svg-sprite" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
<symbol id="nav-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></symbol>
<symbol id="nav-server" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01M11 7h6M11 17h6"/></symbol>
<symbol id="nav-client" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="13" rx="2"/><path d="M8 21h8M12 16v5"/></symbol>
<symbol id="nav-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 9-9M16 4l4 4M14 6l4 4"/></symbol>
<symbol id="nav-more" viewBox="0 0 24 24"><path d="M5 12h.01M12 12h.01M19 12h.01"/></symbol>
</svg>
<header class="site-header">
<div class="site-header-main">
<p class="brand">sshmgr 管理界面</p>
<p class="role">{{.Caps.RoleLabel}}{{if .Caps.CanWrite}} · 全功能可写{{end}}</p>
{{if and .Caps.CanWrite .Authenticated}}
<nav class="header-actions">
{{if .Caps.ShowAuthorityActions}}
<a href="/ui/password">修改口令</a>
<form method="post" action="/ui/logout"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button type="submit">注销</button></form>
<form method="post" action="/ui/logout-all"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button type="submit">注销全部会话</button></form>
{{end}}
</nav>
{{end}}
</div>
<nav class="primary-nav" aria-label="一级导航">
<a href="/ui/"{{if eq .NavCurrent "home"}} aria-current="page"{{end}}><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#nav-home"/></svg>主页</a>
<a href="/ui/servers/"{{if eq .NavCurrent "servers"}} aria-current="page"{{end}}><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#nav-server"/></svg>服务器</a>
{{if .Caps.ShowClientsTab}}<a href="{{.Caps.ClientsTabPath}}"{{if eq .NavCurrent "clients"}} aria-current="page"{{end}}><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#nav-client"/></svg>客户端</a>{{end}}
{{if .Caps.ShowAuthorizationTab}}<a href="{{.Caps.AuthorizationTabPath}}"{{if eq .NavCurrent "authorization"}} aria-current="page"{{end}}><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#nav-key"/></svg>授权</a>{{end}}
{{if .Caps.ShowMoreTab}}<a href="{{.Caps.MoreTabPath}}"{{if eq .NavCurrent "more"}} aria-current="page"{{end}}><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#nav-more"/></svg>更多</a>{{end}}
</nav>
</header>
{{if .VersionHint}}<p class="version-hint">{{.VersionHint}}</p>{{end}}
{{if .Caps.ReadOnlyNotice}}<p class="readonly-notice">{{.Caps.ReadOnlyNotice}}</p>{{end}}
<main id="content">
{{template "content" .}}
</main>
</body>
</html>{{end}}
