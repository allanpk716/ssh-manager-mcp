{{define "layout"}}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"includeIndicatorStyles":false}'>
<meta name="csrf-token" content="{{.CSRFToken}}">
<title>{{.Title}} · sshmgr</title>
<link rel="stylesheet" href="{{index .Assets "app.css"}}">
<script src="{{index .Assets "htmx.min.js"}}" defer></script>
<script src="{{index .Assets "app.js"}}" defer></script>
</head>
<body>
<header class="site-header">
<p class="brand">sshmgr 管理界面</p>
<p class="role">{{.Caps.RoleLabel}}{{if .Caps.CanWrite}} · 全功能可写{{end}}</p>
{{if and .Caps.ShowAuthorityActions .Authenticated}}
<nav class="header-actions">
<a href="/ui/password">修改口令</a>
<form method="post" action="/ui/logout"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button type="submit">注销</button></form>
<form method="post" action="/ui/logout-all"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button type="submit">注销全部会话</button></form>
</nav>
{{end}}
</header>
{{if .Caps.ShowAccessArea}}<nav class="main-nav" aria-label="访问区域">
<a href="/ui/access/">访问</a>
{{if .Caps.CanManageProfiles}}<a href="/ui/access/profiles">Profile</a>{{end}}
{{if .Caps.HasPairingAndDeviceCodes}}<a href="/ui/access/pairing">配对</a>{{end}}
{{if .Caps.HasPairingAndDeviceCodes}}<a href="/ui/access/device-codes">设备码</a>{{end}}
</nav>{{end}}
{{if .VersionHint}}<p class="version-hint">{{.VersionHint}}</p>{{end}}
{{if .Caps.ReadOnlyNotice}}<p class="readonly-notice">{{.Caps.ReadOnlyNotice}}</p>{{end}}
<main id="content">
{{template "content" .}}
</main>
</body>
</html>{{end}}
