{{define "content"}}
<section class="server-list-page" data-server-list-page>
<div class="title-row">
<h1>服务器<span class="title-count">{{len .ServerCards}}</span></h1>
{{if .Caps.CanWrite}}<div class="title-actions">
<a class="primary-button" href="/ui/servers/new">新增服务器</a>
</div>{{end}}
</div>
{{if .NextSteps}}
<section class="notice notice-info next-steps" aria-labelledby="next-steps-title">
<h2 id="next-steps-title">下一步引导</h2>
<ul>
{{range .NextSteps}}<li><a href="{{.Href}}">{{.Title}}</a><p>{{.Description}}</p></li>{{end}}
</ul>
</section>
{{end}}
<div class="inline-form server-actions">
{{if .Caps.CanWrite}}
<a class="secondary-button" href="/ui/servers/import">导入 SSH 配置</a>
<a class="secondary-button" href="/ui/servers/complete?{{completeQueue .ServerList}}&amp;position=0">逐台补全需要注意的服务器</a>
<button class="secondary-button" type="button" aria-pressed="false" data-server-multi-select><span data-server-multi-select-label>多选</span></button>
{{end}}
</div>
<form class="server-filter-form" method="get" action="/ui/servers/" aria-label="搜索与筛选服务器" data-server-filter-form>
<div class="form-field search-field">
<label for="server-search">搜索</label>
<input id="server-search" name="query" value="{{.ServerListFilter.Query}}" type="search" autocomplete="off" aria-label="搜索服务器" placeholder="名称、地址、地点或网络">
</div>
<div class="server-filter-pills" role="group" aria-label="筛选条件">
{{if .ServerListFilter.HasTopology}}
<div class="server-filter-selects" data-server-filter-selects>
<div class="form-field">
<label for="server-site-filter">地点</label>
<select id="server-site-filter" name="site" aria-label="按地点筛选">
{{range .ServerListFilter.Sites}}<option value="{{.Value}}"{{if eq $.ServerListFilter.Site .Value}} selected{{end}}>{{.Label}}{{if .Note}} · {{.Note}}{{end}} · {{.Count}} 台</option>{{end}}
</select>
</div>
<div class="form-field">
<label for="server-network-filter">网络</label>
<select id="server-network-filter" name="network" aria-label="按网络筛选">
{{range .ServerListFilter.Networks}}<option value="{{.Value}}"{{if eq $.ServerListFilter.Network .Value}} selected{{end}}>{{.Label}}{{if .Note}} · {{.Note}}{{end}} · {{.Count}} 台</option>{{end}}
</select>
</div>
{{end}}
</div>
<label class="switch-control attention-switch"><input type="checkbox" name="attention" value="1"{{if .ServerListFilter.Attention}} checked{{end}}><span class="switch-track" aria-hidden="true"></span><span>只看需要注意</span></label>
<button class="no-script-filter-submit" type="submit" data-no-script-filter-submit>应用筛选</button>
</div>
</form>
{{if .ServerListFilter.HasTopology}}
<div class="server-filter-buttons" hidden data-server-filter-buttons>
<button class="filter-button{{if .ServerListFilter.Site}} active{{end}}" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="server-site-filter-sheet" data-open-server-filter="site"><strong>{{if .ServerListFilter.Site}}{{.ServerListFilter.SiteLabel}}{{else}}全部地点{{end}}</strong><span aria-hidden="true">▾</span></button>
<button class="filter-button{{if .ServerListFilter.Network}} active{{end}}" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="server-network-filter-sheet" data-open-server-filter="network"><strong>{{if .ServerListFilter.Network}}{{.ServerListFilter.NetworkLabel}}{{else}}全部网络{{end}}</strong><span aria-hidden="true">▾</span></button>
</div>
{{end}}
<div class="active-filters" aria-live="polite" data-server-filter-live="polite">
{{range .ServerListFilter.Pills}}<span class="active-pill">{{.Label}}<a href="{{.Href}}" aria-label="清除{{.Label}}">✕</a></span>{{end}}
{{if .ServerListFilter.Pills}}<a class="clear-all" href="{{.ServerListFilter.ClearAllHref}}">清除全部</a>{{end}}
</div>
<p class="section-note">需要注意的排在最前。</p>
<div class="server-card-list" aria-label="服务器卡片">
{{range .ServerCards}}
<article class="shared-card server-card{{if .AttentionReasons}} needs-attention{{end}}" data-server-card data-card-site="{{.SiteID}}" data-card-network="{{joinTags .NetworkIDs}}" data-card-search="{{.SearchText}}">
<div class="server-card-heading">
<div class="server-card-title">
<h2><a href="/ui/servers/{{.ID}}">{{.Name}}</a></h2>
<p class="server-address">{{.User}}@{{.Host}}:{{.Port}}</p>
</div>
{{if $.Caps.CanWrite}}<label class="server-select-control" title="选择 {{.Name}}"><input type="checkbox" value="{{.ID}}" aria-label="选择 {{.Name}}"></label>{{end}}
</div>
<p class="server-card-context">{{if .SitePath}}{{.SitePath}}{{else}}地点未登记{{end}}{{if .NetworkNames}} · {{joinTags .NetworkNames}}{{end}}{{if gt .SameMachineCount 1}}<span class="same-machine-chip">同机 {{.SameMachineCount}} 个账号</span>{{end}}</p>
{{if .AttentionReasons}}<div class="server-attention-tags" aria-label="需要注意的原因">{{range .AttentionReasons}}<span class="attention-reason-tag">{{reasonLabel .}}</span>{{end}}</div>{{end}}
<p class="server-card-stats"><span>能看见 <strong>{{.ClientCount}}</strong> 个客户端</span><span><strong>{{.SecretCount}}</strong> 个机密项</span><span><strong>{{.SharedStoreCount}}</strong> 个共享存储</span></p>
{{if $.Caps.CanWrite}}{{if .ConnectionTest}}
<p class="server-test-line {{if .ConnectionTest.Succeeded}}is-succeeded{{else}}is-failed{{end}}" data-server-connection-status>
<span class="status-dot" aria-hidden="true"></span>
<span class="server-test-copy"><strong class="server-test-title">{{formatConnectionTestCardTime .ConnectionTest.CompletedAt}} {{.ConnectionTest.ShortStatusText}}{{if not .ConnectionTest.Succeeded}}：{{.ConnectionTest.FailureLabel}}{{end}}</strong>{{if .ConnectionTest.Succeeded}}<span class="server-test-detail">{{.ConnectionTest.SuccessSummaryText}}</span>{{end}}</span>
</p>
{{else}}
<p class="server-test-line is-untested" data-server-connection-status>
<span class="status-dot" aria-hidden="true"></span>
<span class="server-test-copy"><strong class="server-test-title">从未测试</strong></span>
</p>
{{end}}
{{end}}
<div class="server-row-actions">
<a href="/ui/servers/{{.ID}}">详情</a>
{{if $.Caps.CanWrite}}<a href="/ui/servers/{{.ID}}/edit">编辑</a><a href="/ui/servers/{{.ID}}/delete">删除</a>{{end}}
</div>
</article>
{{else}}
<section class="empty-inline">没有符合条件的服务器。<a href="{{.ServerListFilter.ClearAllHref}}">清除筛选</a></section>
{{end}}
</div>
{{if .ServerListFilter.HasTopology}}
<div class="drawer-shell server-filter-sheet" id="server-site-filter-sheet" data-server-filter-sheet hidden>
<button class="drawer-backdrop" type="button" data-close-server-filter aria-label="关闭地点筛选"></button>
<section class="drawer" role="dialog" aria-modal="true" aria-labelledby="server-site-filter-title">
<div class="drawer-handle" aria-hidden="true"></div>
<h2 id="server-site-filter-title">按地点筛选</h2>
<p class="section-note">选任意一级都会包含它的全部下级地点；选择后立即生效。</p>
<div class="server-filter-options">
{{range .ServerListFilter.Sites}}<button class="filter-option{{if eq $.ServerListFilter.Site .Value}} selected{{end}}" type="button" data-server-filter-choice="site" data-filter-value="{{.Value}}"><span class="filter-option-copy"><strong>{{.Label}}</strong>{{if .Note}}<small>{{.Note}}</small>{{end}}</span><span class="filter-option-count">{{.Count}} 台</span></button>{{end}}
</div>
</section>
</div>
<div class="drawer-shell server-filter-sheet" id="server-network-filter-sheet" data-server-filter-sheet hidden>
<button class="drawer-backdrop" type="button" data-close-server-filter aria-label="关闭网络筛选"></button>
<section class="drawer" role="dialog" aria-modal="true" aria-labelledby="server-network-filter-title">
<div class="drawer-handle" aria-hidden="true"></div>
<h2 id="server-network-filter-title">按网络筛选</h2>
<p class="section-note">只列已登记的物理局域网与虚拟局域网；选择后立即生效。</p>
<div class="server-filter-options">
{{range .ServerListFilter.Networks}}<button class="filter-option{{if eq $.ServerListFilter.Network .Value}} selected{{end}}" type="button" data-server-filter-choice="network" data-filter-value="{{.Value}}"><span class="filter-option-copy"><strong>{{.Label}}</strong>{{if .Note}}<small>{{.Note}}</small>{{end}}</span><span class="filter-option-count">{{.Count}} 台</span></button>{{end}}
</div>
</section>
</div>
{{end}}
</section>
{{if and .Caps.CanWrite .ServerBatch}}
<section class="server-selection-bar" data-server-selection-bar hidden aria-label="多选操作">
<div class="server-batch-summary">
<strong data-server-selected-count>已选 0 台</strong>
<div class="server-batch-tools">
<button type="button" data-server-select-all>全选当前筛选结果</button>
<button type="button" data-server-cancel-selection>取消</button>
</div>
</div>
<div class="server-batch-actions">
<button type="button" data-server-set-location-action disabled title="批量设置地点流程尚未开放">设置地点</button>
<button type="button" data-server-test-connection-action disabled title="批量测试尚未开放，将由后续版本提供">测试连接</button>
<button type="button" data-server-more-button disabled>更多 ⋯</button>
</div>
</section>
<div class="drawer-shell" data-server-more-drawer hidden>
<button class="drawer-backdrop" type="button" data-close-more aria-label="关闭更多批量操作"></button>
<section class="drawer" role="dialog" aria-modal="true" aria-labelledby="server-more-title">
<div class="drawer-handle" aria-hidden="true"></div>
<h2 id="server-more-title">更多批量操作</h2>
<p class="section-note">以下操作仍按已选服务器条目执行。</p>
<div class="server-more-list">
<button class="resource-card" type="button" data-batch-button="profiles"><span class="resource-copy"><strong>加入 profile</strong><small>把这批服务器加入指定的客户端 profile</small></span></button>
<button class="resource-card" type="button" data-batch-button="secrets"><span class="resource-copy"><strong>授权机密项</strong><small>选择要写入这些服务器的机密项</small></span></button>
<button class="resource-card" type="button" data-batch-button="shares"><span class="resource-copy"><strong>授权共享存储</strong><small>让这些服务器可以挂载指定共享存储</small></span></button>
</div>
</section>
</div>
<div class="drawer-shell" data-server-batch-drawer hidden>
<button class="drawer-backdrop" type="button" data-close-batch aria-label="关闭批量操作"></button>
<section class="drawer" role="dialog" aria-modal="true" aria-labelledby="server-batch-title">
<div class="drawer-handle" aria-hidden="true"></div>
<h2 id="server-batch-title">选择要批量调整的资源</h2>
<p>已选服务器会带入下一页的共用勾选组件，确认后才写入授权。</p>
{{if .ServerBatch.Profiles}}
<section data-batch-panel="profiles">
<h3>Profile</h3>
<div class="row-list">
{{range .ServerBatch.Profiles}}<a class="resource-card" href="{{.Path}}" data-batch-resource><span class="resource-copy"><strong>{{.Name}}</strong><small>加入选中的服务器</small></span></a>{{end}}
</div>
</section>
{{end}}
{{if .ServerBatch.Secrets}}
<section data-batch-panel="secrets">
<h3>机密项</h3>
<div class="row-list">
{{range .ServerBatch.Secrets}}<a class="resource-card" href="{{.Path}}" data-batch-resource><span class="resource-copy"><strong>{{.Name}}</strong><small>{{if .Note}}{{.Note}}{{else}}缺备注{{end}}</small></span></a>{{end}}
</div>
</section>
{{end}}
{{if .ServerBatch.SharedStores}}
<section data-batch-panel="shares">
<h3>共享存储</h3>
<div class="row-list">
{{range .ServerBatch.SharedStores}}<a class="resource-card" href="{{.Path}}" data-batch-resource><span class="resource-copy"><strong>{{.Name}}</strong><small>{{if .Note}}{{.Note}}{{else}}缺备注{{end}}</small></span></a>{{end}}
</div>
</section>
{{end}}
</section>
</div>
{{end}}
{{end}}
