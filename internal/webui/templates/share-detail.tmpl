{{define "content"}}
<section class="share-detail">
<h1>共享存储 {{.ShareDetail.Name}}</h1>
{{if .ShareDetailNotice}}<div class="operation-refusal">{{.ShareDetailNotice}}</div>{{end}}
{{if .ShareDetailError}}<div class="operation-refusal">{{.ShareDetailError}}</div>{{end}}
<dl class="detail-list">
<dt>共享名</dt><dd>{{.ShareDetail.Name}}</dd>
<dt>提供方设备</dt><dd>{{.ShareDetail.DeviceName}}</dd>
<dt>挂载账号用户名</dt><dd>{{.ShareDetail.MountUser}}</dd>
<dt>挂载密码机密项</dt><dd>{{.ShareDetail.PasswordSecret}}</dd>
<dt>固定盘符</dt><dd>{{.ShareDetail.Drive}}:</dd>
<dt>目录约定</dt>
<dd>
{{if .ShareDetail.Directories}}
<ul>
{{range .ShareDetail.Directories}}<li>{{.Purpose}}={{.Path}}</li>{{end}}
</ul>
{{else}}（无）{{end}}
</dd>
<dt>共享存储版本号</dt><dd>{{.ShareDetail.Version}}</dd>
<dt>变更说明</dt><dd>{{or .ShareDetail.ChangeNote "（无）"}}</dd>
<dt>备注</dt><dd>{{or .ShareDetail.Note "（无）"}}</dd>
</dl>
<section class="share-mountable-servers">
<h2>可挂载服务器</h2>
{{if .ShareDetail.MountableServers}}
<table class="server-table">
<thead><tr><th>服务器条目</th><th>所属设备</th><th>系统类型</th><th>挂载点</th></tr></thead>
<tbody>
{{range .ShareDetail.MountableServers}}
<tr><td>{{.Name}}</td><td>{{or .DeviceName "（未登记设备）"}}</td><td>{{.ShellType}}</td><td>{{.MountPoint}}</td></tr>
{{end}}
</tbody>
</table>
{{else}}<p>（无）</p>{{end}}
{{if .ShareAuthorization}}
<form method="post" action="/ui/secrets/authorization/preview" class="share-scope-form" data-share-scope-form>
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="return_to" value="/ui/shares/{{.ShareDetail.ID}}">
<input type="hidden" name="secret_id" value="{{.ShareAuthorization.SecretID}}">
{{range .ShareAuthorization.Servers}}<input type="hidden" name="server_id" value="{{.ID}}">{{end}}
<fieldset><legend>可挂载范围勾选清单</legend>
<table class="server-table">
<thead><tr><th>服务器条目</th><th>所属设备</th><th>系统类型</th></tr></thead>
<tbody>
{{range .ShareAuthorization.Servers}}
<tr data-share-scope-device="{{.DeviceName}}">
<td>
<label class="grant-choice"><input type="checkbox" name="cell__{{$.ShareAuthorization.SecretID}}__{{.ID}}" value="1"{{if .Checked}} checked{{end}}><span>{{.Name}}</span>
{{if .SharesDeviceWithOtherEntries}}<small data-share-scope-warning hidden>同设备的其他条目可能也能读到挂载内容。</small>{{end}}
</label>
</td>
<td>{{or .DeviceName "（未登记设备）"}}</td>
<td>{{.ShellType}}</td>
</tr>
{{end}}
</tbody>
</table>
<button type="submit">预览可挂载范围变更</button>
</fieldset>
</form>
{{end}}
{{/*
现场探测（#257）、挂载与卸载（#258）、撤销（#259）、
重选地址与残留检查（#260）在后续票挂载到本页。
*/}}
{{if .Caps.CanUseShareDesktopGuide}}
<section class="share-desktop-guide-entry">
<h2>桌面手动添加</h2>
<p>给 owner 自己的 Windows 或 macOS 电脑推算地址并查看手动映射步骤；页面不会显示共享密码。</p>
<a class="button-link" href="/ui/shares/{{.ShareDetail.ID}}/desktop">打开桌面手动添加引导</a>
</section>
{{end}}
</section>
<div class="inline-form share-actions">
{{if .Caps.CanManageShares}}<a class="button-link" href="/ui/shares/{{.ShareDetail.ID}}/edit">编辑</a>
<a class="button-link danger" href="/ui/shares/{{.ShareDetail.ID}}/delete">删除</a>{{end}}
<a class="button-link" href="/ui/shares/">返回共享存储列表</a>
</div>
</section>
{{end}}
