{{define "content"}}
<section class="initialization-page">
<h1>初始化权威端</h1>
<ol class="initialization-steps">
{{range .InitializationSteps}}
<li{{if .Current}} class="current"{{else if .Done}} class="done"{{end}}>{{.Label}}</li>
{{end}}
</ol>
{{if .InitializationError}}<div class="operation-refusal"><p>{{.InitializationError}}</p></div>{{end}}
<form class="initialization-form" method="post" action="/ui/init/server/password/set">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<label for="admin-password">输入管理员口令</label>
<input type="password" id="admin-password" name="password" autocomplete="new-password" required>
<label for="admin-password-confirm">再输入一遍</label>
<input type="password" id="admin-password-confirm" name="password_confirm" autocomplete="new-password" required>
<p class="initialization-note">口令规则与命令行 <code>sshmgr serve admin set</code> 一致：不能为空，两次输入必须一致。</p>
<button type="submit">设置管理员口令</button>
</form>
</section>
{{end}}
