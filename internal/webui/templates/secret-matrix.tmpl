{{define "content"}}
<section class="secret-matrix" data-secret-matrix>
<h1>机密项授权矩阵</h1>
<form class="filter-form" method="get" action="/ui/secrets/matrix">
<label for="matrix-query">搜索名字或备注</label>
<input type="search" id="matrix-query" name="query" value="{{.SecretMatrix.Query}}">
<label for="matrix-server">可见服务器</label>
<select id="matrix-server" name="server">
<option value="">全部服务器</option>
{{range .SecretServerOptions}}<option value="{{.Name}}"{{if eq $.SecretMatrix.Server .Name}} selected{{end}}>{{.Name}}</option>{{end}}
</select>
<button type="submit">缩小范围</button>
</form>
<p class="form-help">整行、整列与交叉操作只作用于当前可见格子；提交前先预览。</p>
<form method="post" action="/ui/secrets/authorization/preview">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="return_to" value="/ui/secrets/matrix">
{{range .SecretMatrix.Rows}}<input type="hidden" name="secret_id" value="{{.Secret.ID}}">{{end}}
{{range .SecretMatrix.Servers}}<input type="hidden" name="server_id" value="{{.ID}}">{{end}}
<div class="matrix-tools">
<span>多选行列交叉：</span>
<button type="button" data-matrix-action="intersection-check">勾选交叉</button>
<button type="button" data-matrix-action="intersection-uncheck">取消交叉</button>
</div>
<div class="matrix-scroll">
<table class="server-table secret-matrix-table">
<thead><tr><th>机密项</th>{{range .SecretMatrix.Servers}}<th scope="col"><span>{{.Name}}</span><label><input type="checkbox" value="{{.ID}}" data-column-selector="{{.ID}}">选择列</label><button type="button" data-column="{{.ID}}" data-matrix-action="column-check">整列勾选</button><button type="button" data-column="{{.ID}}" data-matrix-action="column-uncheck">整列取消</button></th>{{end}}</tr></thead>
<tbody>
{{range .SecretMatrix.Rows}}
{{$row := .}}
<tr data-secret="{{.Secret.ID}}">
<th scope="row"><a href="/ui/secrets/{{.Secret.ID}}">{{.Secret.Name}}</a><label><input type="checkbox" value="{{.Secret.ID}}" data-row-selector="{{.Secret.ID}}">选择行</label><button type="button" data-row="{{.Secret.ID}}" data-matrix-action="row-check">整行勾选</button><button type="button" data-row="{{.Secret.ID}}" data-matrix-action="row-uncheck">整行取消</button></th>
{{range .Cells}}<td><label><input type="checkbox" name="cell__{{$row.Secret.ID}}__{{.ID}}" value="1"{{if .Checked}} checked{{end}} aria-label="{{$row.Secret.Name}} {{.Name}}" data-secret-cell="{{$row.Secret.ID}}" data-server-cell="{{.ID}}"><span aria-hidden="true">授权</span></label></td>{{end}}
</tr>
{{end}}
</tbody>
</table>
</div>
<button type="submit">预览授权变更</button>
<a class="button-link" href="/ui/secrets/">取消</a>
</form>
</section>
{{end}}
