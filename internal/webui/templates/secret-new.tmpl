{{define "content"}}
<section class="secret-form">
<h1>新增机密项</h1>
{{if .SecretForm.Error}}<div class="operation-refusal">{{.SecretForm.Error}}</div>{{end}}
{{if .SecretForm.NeedsReverify}}<div class="operation-refusal">新增机密项前需要重新验证管理员口令。<a href="{{.SecretForm.ReverifyPath}}">先重新验证</a></div>{{end}}
<form method="post" action="/ui/secrets/new" enctype="multipart/form-data">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<div class="form-field"><label for="secret-name">名字</label><input type="text" id="secret-name" name="name" value="{{.SecretForm.Name}}" required></div>
<div class="form-field"><label for="secret-note">备注</label><input type="text" id="secret-note" name="note" value="{{.SecretForm.Note}}"></div>
<div class="form-field"><label for="secret-env">环境变量名（可选）</label><input type="text" id="secret-env" name="environment_name" value="{{.SecretForm.EnvironmentName}}"></div>
<div class="form-field"><label for="secret-value">值</label><input type="password" id="secret-value" name="value" autocomplete="new-password"></div>
<div class="form-field"><label for="secret-value-file">或上传文件作为值</label><input type="file" id="secret-value-file" name="value_file"></div>
<p class="form-help">值不会显示、复制或读回；换值后上一个值仍会参与输出遮蔽。上传文件最大 64 KiB。</p>
<button type="submit">新增</button>
<a class="button-link" href="/ui/secrets/">取消</a>
</form>
</section>
{{end}}
