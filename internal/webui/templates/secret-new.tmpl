{{define "content"}}
{{if .Authorization}}{{template "authorization-subpage" .}}{{end}}
<section class="drawer-form-page">
<a class="back-link" href="/ui/authorization/secrets" aria-label="返回机密项"><span aria-hidden="true">‹</span>机密项</a>
<h1>新建机密项</h1>
{{if .SecretForm.Error}}<div class="operation-refusal">{{.SecretForm.Error}}</div>{{end}}
{{if .SecretForm.NeedsReverify}}<div class="operation-refusal">创建前需要重新验证管理员口令。<a href="{{.SecretForm.ReverifyPath}}">先重新验证</a></div>{{end}}
<form method="post" action="/ui/authorization/secrets/new" data-required-note-form>
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<div class="form-field"><label for="secret-name">名称</label><input type="text" id="secret-name" name="name" value="{{.SecretForm.Name}}" required placeholder="例如 API_TOKEN"></div>
<div class="form-field"><label for="secret-note">备注<span class="required-mark">*</span></label><textarea id="secret-note" name="note" required data-required-note placeholder="它是什么、给谁用，例如：HuggingFace 下载令牌，训练机拉模型用">{{.SecretForm.Note}}</textarea></div>
<p class="form-help">agent 只能靠备注判断这个机密项的用途。</p>
<div class="form-field"><label for="secret-value">值</label><input type="password" id="secret-value" name="value" autocomplete="new-password"></div>
<div class="form-field"><label for="secret-environment">环境变量名（可选）</label><input type="text" id="secret-environment" name="environment_name" value="{{.SecretForm.EnvironmentName}}" placeholder="例如 $API_TOKEN"></div>
<div class="form-field"><label for="secret-value-file">或上传文件作为值</label><input type="file" id="secret-value-file" name="value_file"></div>
<p class="form-help">值不会显示、复制或读回；换值后上一个值仍会参与输出遮蔽。上传文件最大 64 KiB。</p>
<div class="form-actions"><a class="button-link" href="/ui/authorization/secrets">取消</a><button type="submit" data-note-submit disabled>创建</button></div>
</form>
</section>
{{end}}
