{{define "content"}}
<section class="pairing-page">
<h1>批准配对</h1>
{{if .AccessPairingNotice}}<div class="{{if .AccessPairingSuccess}}operation-result{{else}}operation-refusal{{end}}" role="alert">{{.AccessPairingNotice}}</div>{{end}}
{{with .AccessPairing}}
{{if ne .State "pending"}}
<div class="operation-refusal">
<p>该配对请求已处理，不能再批准或拒绝。</p>
<a class="back-link" href="/ui/clients/pairing" aria-label="返回配对列表"><span aria-hidden="true">‹</span>配对列表</a>
</div>
{{end}}
<article class="pairing-request{{if not .HasShortCode}} pairing-missing-code{{end}}{{if .ForeignTarget}} pairing-foreign{{end}}">
<div class="pairing-comparison">
<h2 class="pairing-instance">{{.Name}}</h2>
<p><span>对方连接的权威端地址</span><span class="pairing-target">{{.TargetURL}}</span></p>
<p><span>6 位短认证码</span>{{if .HasShortCode}}<code class="pairing-short-code">{{.ShortCode}}</code>{{else}}<strong>行缺少短认证码，只能拒绝</strong>{{end}}</p>
</div>
<dl class="pairing-fields">
<div><dt>来源地址</dt><dd>{{.SourceAddress}}</dd></div>
<div><dt>profile 提示</dt><dd>{{if .ProfileHint}}{{.ProfileHint}}{{else}}未声明{{end}}</dd></div>
<div><dt>替换同名设备</dt><dd>{{if .ReplaceInactive}}替换同名客户端的未激活接入凭据{{else}}不替换{{end}}</dd></div>
<div><dt>状态</dt><dd>{{if eq .State "pending"}}剩余 {{.RemainingSeconds}} 秒{{else if eq .State "approved"}}已批准，等待客户端完成（剩余 {{.RemainingSeconds}} 秒）{{else}}已完成{{end}}</dd></div>
</dl>
{{if and (eq .State "pending") .ForeignTarget}}
<div class="operation-refusal pairing-foreign-warning" role="alert">
这条请求连接的地址不是本机，也不在已登记的对外地址里，可能有人在中间转发。建议拒绝。若确认是你自己的网络，请先把该地址登记为本机对外地址（serve.public_addresses），或用命令行批准。
</div>
{{end}}
{{if eq .State "pending"}}
<div class="pairing-actions">
{{if and .HasShortCode (not .ForeignTarget)}}
<form method="post" action="/ui/clients/pairing/{{.ID}}/approve" class="pairing-form">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<label for="pairing-profile">批准到 profile</label>
<select id="pairing-profile" name="profile" required>
{{range $profile := $.AccessProfiles}}<option value="{{$profile.ID}}"{{if $.AccessPairing.ProfileSelected $profile.ID $.AccessPairingForm}} selected{{end}}>{{$profile.Name}}</option>{{end}}
</select>
<label class="pairing-compare"><input type="checkbox" name="compared" value="1"{{if $.AccessPairing.KeepCompared $.AccessPairingForm}} checked{{end}} required>我已逐位比对三项一致</label>
<button type="submit">批准</button>
</form>
{{end}}
<form method="post" action="/ui/clients/pairing/{{.ID}}/reject" class="inline-form pairing-reject-form">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<button type="submit">拒绝</button>
</form>
</div>
{{end}}
</article>
{{else}}
<div class="operation-refusal">
<p>配对请求已过期或已处理，请返回列表查看最新状态。</p>
<a class="back-link" href="/ui/clients/pairing" aria-label="返回配对列表"><span aria-hidden="true">‹</span>配对列表</a>
</div>
{{end}}
</section>
{{end}}
